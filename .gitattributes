# Keep every text file as LF in the repository and in the working folder,
# on Windows too. That way a file's checksum is the same on every machine,
# and Prettier does not complain about line endings.
* text=auto eol=lf

# Files that are not text. Git must never touch their bytes.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.docx binary
